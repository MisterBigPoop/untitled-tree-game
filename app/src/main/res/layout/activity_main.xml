                    android:id="@+id/card_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#9C27B0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/title_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quantum Computing"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/desc_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Ultra-fast processors"
                            android:textSize="14sp"
                            android:textColor="#E0E0E0" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/level_6"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Level: 0/5"
                                android:textSize="12sp"
                                android:textColor="#B0BEC5" />

                            <TextView
                                android:id="@+id/cost_6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cost: 5000"
                                android:textSize="12sp"
                                android:textColor="#FFD700"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="UPGRADE"
                            android:onClick="onUpgradeClick"
                            android:tag="6" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Upgrade 7 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FF5722">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/title_7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
