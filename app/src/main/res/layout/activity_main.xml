                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Level: 0/8"
                                android:textSize="12sp"
                                android:textColor="#B0BEC5" />

                            <TextView
                                android:id="@+id/cost_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cost: 200"
                                android:textSize="12sp"
                                android:textColor="#FFD700"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="UPGRADE"
                            android:onClick="onUpgradeClick"
                            android:tag="2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Upgrade 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#2196F3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/title_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Energy"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/desc_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Energy production"
                            android:textSize="14sp"
                            android:textColor="#E0E0E0" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/level_3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Level: 0/7"
                                android:textSize="12sp"
                                android:textColor="#B0BEC5" />

                            <TextView
                                android:id="@+id/cost_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cost: 500"
                                android:textSize="12sp"
                                android:textColor="#FFD700"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="UPGRADE"
                            android:onClick="onUpgradeClick"
                            android:tag="3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Upgrade 4 -->
